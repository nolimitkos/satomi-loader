local function GetClosestPlayer()
    local closestPlayer = nil
    local closestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if IsWhitelisted(player.UserId) then
                continue
            end
            local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHumanoid = player.Character:FindFirstChild("Humanoid")
            if targetHRP and targetHumanoid and targetHumanoid.Health > 0 then
                local distance = (HumanoidRootPart.Position - targetHRP.Position).Magnitude
                if distance <= 20 and distance < closestDistance then
                    closestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

local function FireMelee(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHumanoid = targetPlayer.Character:FindFirstChild("Humanoid")
    if not targetHumanoid or targetHumanoid.Health <= 0 then return end

    local args = {
        targetPlayer,
        1,
        1
    }
    ReplicatedStorage:WaitForChild("meleeEvent"):FireServer(unpack(args))
end

local function StartMeleeAura()
    if auraConnection then auraConnection:Disconnect() end
    auraConnection = RunService.Heartbeat:Connect(function()
        if not meleeAuraEnabled then return end
        local target = GetClosestPlayer()
        if target then
            FireMelee(target)
        end
    end)
end

local function StopMeleeAura()
    if auraConnection then
        auraConnection:Disconnect()
        auraConnection = nil
    end
end

