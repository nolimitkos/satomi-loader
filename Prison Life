local function GetHandcuffsTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    return char:FindFirstChild("Handcuffs") or (backpack and backpack:FindFirstChild("Handcuffs"))
end

local function IsValidArrestTarget(player, character)
    if player == LocalPlayer then return false end
    if IsWhitelisted(player.UserId) then return false end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if character:FindFirstChildOfClass("ForceField") then return false end
    
    local attrs = character:GetAttributes()
    local team = player.Team
    
    if team == Teams.Criminals then
        return true
    end
    
    if team == Teams.Inmates then
        if attrs.Hostile and not attrs.Tased then
            return true
        end
        if attrs.Trespassing then
            return true
        end
    end
    
    return false
end

local function GetClosestValidArrestTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local closest = nil
    local closestDist = ArrestRange
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local targetChar = player.Character
        if not targetChar then continue end
        local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetHrp then continue end
        
        if not IsValidArrestTarget(player, targetChar) then continue end
        
        local dist = (targetHrp.Position - hrp.Position).Magnitude
        if dist <= closestDist then
            closestDist = dist
            closest = player
        end
    end
    
    return closest
end

local function AutoArrestLoop()
    if not autoArrestEnabled then return end
    if os.clock() - LastArrest < ArrestCooldown then return end
    
    local target = GetClosestValidArrestTarget()
    if not target then return end
    
    local handcuffs = GetHandcuffsTool()
    if not handcuffs then return end
    
    local success = ArrestRemote:InvokeServer(target, 1)
    if success then
        LastArrest = os.clock()
    end
end

local function StartAutoArrest()
    if autoArrestConnection then return end
    autoArrestConnection = RunService.Heartbeat:Connect(AutoArrestLoop)
end

local function StopAutoArrest()
    if autoArrestConnection then
        autoArrestConnection:Disconnect()
        autoArrestConnection = nil
    end
end

