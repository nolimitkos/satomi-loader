local function AutoCollectLoop()
   local anyGunEquipped = hasAnyGunEquipped()
   local m700Equipped = hasM700Equipped()
   local playerPos = getPlayerPosition()

   for _, itemData in ipairs(AUTO_COLLECT_ITEMS) do
       pcall(function()
           if itemData.skipIfGunEquipped and anyGunEquipped then
               return
           end

           if itemData.equipRequired then
               if not m700Equipped then
                   return
               end
           end

           local current = Workspace
           for _, pathPart in ipairs(itemData.path) do
               current = current:FindFirstChild(pathPart)
               if not current then return end
           end
           local args = {current}
           local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(itemData.remote)
           if itemData.fireType == "InvokeServer" then
               remote:InvokeServer(unpack(args))
           else
               remote:FireServer(unpack(args))
           end
       end)
   end
end

