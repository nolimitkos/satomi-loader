local function applyKorblox(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R6 then
        return
    end
    local leg = character:FindFirstChild("Right Leg")
    if not leg then
        return
    end
    local fakeLeg = character:FindFirstChild("FakeKorbloxLeg")
    if fakeLeg then
        fakeLeg:Destroy()
    end
    leg.Transparency = 1
    local part = Instance.new("Part")
    part.Name = "FakeKorbloxLeg"
    part.Size = leg.Size
    part.CFrame = leg.CFrame
    part.Anchored = false
    part.CanCollide = false
    part.Material = Enum.Material.Plastic
    part.BrickColor = BrickColor.new("Really black")
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = "rbxassetid://" .. korbloxMesh
    mesh.TextureId = "rbxassetid://" .. korbloxTexture
    mesh.Parent = part
    part.Parent = character
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = leg
    weld.Part1 = part
    weld.Parent = part
end

local function applyHeadless(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R6 then
        return
    end
    local head = character:FindFirstChild("Head")
    if not head then
        return
    end
    head.Transparency = 1
    for _, child in pairs(head:GetChildren()) do
        if child:IsA("Decal") or child:IsA("Texture") then
            child:Destroy()
        end
    end
    local face = head:FindFirstChild("face")
    if face then
        face:Destroy()
    end
end

local function applyFakeItems(character)
    applyKorblox(character)
    applyHeadless(character)
end

local function onCharacterAdded(char)
    char:WaitForChild("Humanoid")
