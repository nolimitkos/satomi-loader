local function FindGunGiver(gunName)
    local prisonItems = Workspace:FindFirstChild("Prison_ITEMS")
    if not prisonItems then return nil end
    
    local giver = prisonItems:FindFirstChild("giver")
    if not giver then return nil end
    
    local gunFolder = giver:FindFirstChild(gunName)
    if gunFolder then
        for _, child in ipairs(gunFolder:GetChildren()) do
            if child:IsA("BasePart") or child:IsA("MeshPart") then
                return child
            end
        end
    end
    
    for _, child in ipairs(giver:GetDescendants()) do
        if child.Name == gunName then
            for _, part in ipairs(child:GetChildren()) do
                if part:IsA("BasePart") or part:IsA("MeshPart") then
                    return part
                end
            end
        end
    end
    
    return nil
end

local function FindClothesItem(itemName)
    local prisonItems = Workspace:FindFirstChild("Prison_ITEMS")
    if not prisonItems then return nil end
    
    local clothes = prisonItems:FindFirstChild("clothes")
    if not clothes then return nil end
    
    local folder = clothes:FindFirstChild(itemName)
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("BasePart") or child:IsA("MeshPart") then
                return child
            end
        end
    end
    
    return nil
end

local function AutoCollectItem(itemName, category)
    local target = nil
    if category == "giver" then
        target = FindGunGiver(itemName)
    elseif category == "clothes" then
        target = FindClothesItem(itemName)
    end
    
    if target then
        pcall(function()
            local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("InteractWithItem")
            remote:InvokeServer(target)
        end)
    end
end

