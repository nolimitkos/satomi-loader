            BackgroundTransparency = Enabled and 0.4 or 0.92
        }):Play()

        TweenService:Create(SwitchCircle, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = targetPos
        }):Play()
    end

    ToggleFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Enabled = not Enabled
            UpdateToggle()
            if callback then callback(Enabled) end
        end
    end)

    return ToggleFrame
end

local function EnableAntiTase()
    local GunRemotes = ReplicatedStorage:FindFirstChild("GunRemotes")
    if not GunRemotes then return end
    local PlayerTased = GunRemotes:FindFirstChild("PlayerTased")
    if not PlayerTased then return end

    originalPlayerTased = PlayerTased
    originalPlayerTased.Parent = nil

    antiTaseDummyEvent = Instance.new("RemoteEvent")
    antiTaseDummyEvent.Name = "PlayerTased"
    antiTaseDummyEvent.Parent = GunRemotes

    antiTaseMovementConnection = RunService.Heartbeat:Connect(function()
        antiTaseIsMoving = Humanoid.MoveDirection.Magnitude > 0.01
    end)

    antiTaseEventConnection = antiTaseDummyEvent.OnClientEvent:Connect(function()
        if antiTaseIsMoving then
            return
        end
    end)
end

local function DisableAntiTase()
    if antiTaseMovementConnection then
        antiTaseMovementConnection:Disconnect()
        antiTaseMovementConnection = nil
    end
    if antiTaseEventConnection then
        antiTaseEventConnection:Disconnect()
        antiTaseEventConnection = nil
    end
    if antiTaseDummyEvent then
        antiTaseDummyEvent:Destroy()
        antiTaseDummyEvent = nil
    end
    if originalPlayerTased then
        local GunRemotes = ReplicatedStorage:FindFirstChild("GunRemotes")
        if GunRemotes then
            originalPlayerTased.Parent = GunRemotes
        end
        originalPlayerTased = nil
    end
    antiTaseIsMoving = false
end

