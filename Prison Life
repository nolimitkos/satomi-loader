local function setupFakeItemsForWhitelisted()
    for _, player in ipairs(Players:GetPlayers()) do
        if IsAuraWhitelisted(player.UserId) and player.Character and player ~= LocalPlayer then
            player.CharacterAdded:Connect(function(char)
                if IsAuraWhitelisted(player.UserId) then
                    char:WaitForChild("Humanoid")
                    task.wait(1)
                    applyFakeItems(LocalPlayer.Character)
                end
            end)
        end
        player.CharacterAdded:Connect(function(char)
            if IsAuraWhitelisted(player.UserId) and player ~= LocalPlayer then
                char:WaitForChild("Humanoid")
                task.wait(1)
                applyFakeItems(LocalPlayer.Character)
            end
        end)
    end
    Players.PlayerAdded:Connect(function(player)
        if IsAuraWhitelisted(player.UserId) and player ~= LocalPlayer then
            player.CharacterAdded:Connect(function(char)
                char:WaitForChild("Humanoid")
                task.wait(1)
                applyFakeItems(LocalPlayer.Character)
            end)
            if player.Character then
                task.spawn(function()
                    player.Character:WaitForChild("Humanoid")
                    task.wait(1)
                    applyFakeItems(LocalPlayer.Character)
                end)
            end
        end
    end)
end

setupFakeItemsForWhitelisted()

local function getEquippedTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

local function hasAnyGunEquipped()
    local tool = getEquippedTool()
    if not tool then return false end
    local name = tool.Name
    local guns = {
        ["Remington 870"] = true,
        ["M9"] = true,
        ["AK-47"] = true,
        ["M4A1"] = true,
        ["MP5"] = true,
        ["FAL"] = true,
        ["C4"] = true,
        ["M700"] = true,
        ["Revolver"] = true,
    }
    return guns[name] == true
end

local function hasM700Equipped()
    local tool = getEquippedTool()
    if not tool then return false end
    return tool.Name == "M700"
end

local function isNearCoordinates(pos, target, range)
    range = range or 15
    return (pos - target).Magnitude <= range
end

local function getPlayerPosition()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    return hrp.Position
end

